
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GALAGA - 우주 전투</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #050816;
  color: white;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  overflow: hidden;
}
.game {
  width: min(94vw, 480px);
  text-align: center;
}
h1 {
  color: #42f5ff;
  letter-spacing: 6px;
  text-shadow: 0 0 15px #00ccff;
  margin: 8px 0 14px;
}
.info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
  color: #ffe66d;
  font-weight: bold;
}
canvas {
  display: block;
  width: 100%;
  background: #070b20;
  border: 2px solid #1d7bba;
  border-radius: 8px;
  box-shadow: 0 0 24px #0066aa55;
  touch-action: none;
}
.help {
  color: #aab9dc;
  font-size: 13px;
  line-height: 1.8;
  margin: 12px 0;
}
button {
  background: #00cfff;
  border: none;
  color: #001020;
  font-weight: bold;
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 16px;
  cursor: pointer;
}
button:hover { background: #73efff; }
.mobile {
  display: flex;
  justify-content: space-around;
  gap: 12px;
  margin-top: 8px;
}
.mobile button {
  flex: 1;
  background: #142a50;
  color: white;
  border: 1px solid #328cff;
  touch-action: none;
  user-select: none;
}
</style>
</head>
<body>
<div class="game">
  <h1>GALAGA</h1>
  <div class="info">
    <span>SCORE: <span id="score">0</span></span>
    <span>LEVEL: <span id="level">1</span></span>
    <span>❤️ <span id="lives">3</span></span>
  </div>

  <canvas id="game" width="420" height="620"></canvas>

  <p class="help">
    ← → 또는 A / D : 이동<br>
    SPACE : 발사 · ENTER : 시작 / 재시작
  </p>

  <div class="mobile">
    <button id="left">◀ 왼쪽</button>
    <button id="fire">🔥 발사</button>
    <button id="right">오른쪽 ▶</button>
  </div>
  <p><button id="start">게임 시작</button></p>
</div>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");
const $ = id => document.getElementById(id);

let player, bullets, enemies, enemyBullets, particles, stars;
let score = 0, lives = 3, level = 1;
let running = false, gameOver = false;
let keys = {};
let lastShot = 0, enemyTimer = 0, animationId;
let lastTime = 0;

function reset() {
  score = 0;
  lives = 3;
  level = 1;
  bullets = [];
  enemyBullets = [];
  particles = [];
  stars = Array.from({length: 85}, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    speed: 20 + Math.random() * 70,
    size: Math.random() * 2 + 0.5
  }));
  player = {x: 210, y: 555, w: 30, h: 30, speed: 270};
  spawnEnemies();
  updateInfo();
  gameOver = false;
  running = true;
  $("start").textContent = "다시 시작";
  lastTime = 0;
  cancelAnimationFrame(animationId);
  animationId = requestAnimationFrame(loop);
}

function spawnEnemies() {
  enemies = [];
  const rows = Math.min(3 + level, 6);
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < 8; c++) {
      enemies.push({
        x: 35 + c * 50,
        y: 45 + r * 42,
        baseX: 35 + c * 50,
        w: 25, h: 23,
        phase: Math.random() * 6.28,
        hp: 1
      });
    }
  }
}

function updateInfo() {
  $("score").textContent = score;
  $("lives").textContent = lives;
  $("level").textContent = level;
}

function drawPlayer() {
  ctx.save();
  ctx.translate(player.x, player.y);
  ctx.fillStyle = "#42f5ff";
  ctx.shadowColor = "#00ddff";
  ctx.shadowBlur = 14;
  ctx.beginPath();
  ctx.moveTo(0, -18);
  ctx.lineTo(15, 13);
  ctx.lineTo(5, 9);
  ctx.lineTo(0, 15);
  ctx.lineTo(-5, 9);
  ctx.lineTo(-15, 13);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.fillRect(-3, -5, 6, 10);
  ctx.restore();
}

function drawEnemy(e) {
  ctx.save();
  ctx.translate(e.x, e.y);
  ctx.fillStyle = "#ff426d";
  ctx.shadowColor = "#ff164f";
  ctx.shadowBlur = 9;
  ctx.beginPath();
  ctx.moveTo(-13, -8);
  ctx.lineTo(-6, -14);
  ctx.lineTo(0, -8);
  ctx.lineTo(6, -14);
  ctx.lineTo(13, -8);
  ctx.lineTo(10, 7);
  ctx.lineTo(4, 12);
  ctx.lineTo(0, 7);
  ctx.lineTo(-4, 12);
  ctx.lineTo(-10, 7);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = "#fff27a";
  ctx.fillRect(-7, -4, 4, 4);
  ctx.fillRect(3, -4, 4, 4);
  ctx.restore();
}

function shoot() {
  const now = performance.now();
  if (now - lastShot < 230) return;
  lastShot = now;
  bullets.push({x: player.x, y: player.y - 17, speed: 480});
}

function explode(x, y, color) {
  for (let i = 0; i < 10; i++) {
    const a = Math.random() * Math.PI * 2;
    const s = 30 + Math.random() * 120;
    particles.push({
      x, y, vx: Math.cos(a) * s,
      vy: Math.sin(a) * s,
      life: 0.5 + Math.random() * 0.4,
      color
    });
  }
}

function hitPlayer() {
  lives--;
  explode(player.x, player.y, "#42f5ff");
  updateInfo();
  if (lives <= 0) endGame();
  else {
    player.x = canvas.width / 2;
    enemyBullets = [];
  }
}

function endGame() {
  running = false;
  gameOver = true;
  $("start").textContent = "다시 도전";
  drawOverlay("GAME OVER", "최종 점수: " + score);
}

function drawOverlay(title, subtitle) {
  ctx.fillStyle = "#030716cc";
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.textAlign = "center";
  ctx.fillStyle = "#42f5ff";
  ctx.font = "bold 34px Arial";
  ctx.fillText(title, canvas.width / 2, 270);
  ctx.fillStyle = "white";
  ctx.font = "18px Arial";
  ctx.fillText(subtitle, canvas.width / 2, 310);
  ctx.font = "15px Arial";
  ctx.fillText("시작 버튼 또는 ENTER", canvas.width / 2, 350);
}

function update(dt) {
  // 배경 별
  stars.forEach(s => {
    s.y += s.speed * dt;
    if (s.y > canvas.height) {
      s.y = 0;
      s.x = Math.random() * canvas.width;
    }
  });

  // 플레이어 이동
  if (keys.ArrowLeft || keys.a || keys.A) player.x -= player.speed * dt;
  if (keys.ArrowRight || keys.d || keys.D) player.x += player.speed * dt;
  player.x = Math.max(18, Math.min(canvas.width - 18, player.x));

  if (keys[" "] || keys.Space) shoot();

  // 총알 이동
  bullets.forEach(b => b.y -= b.speed * dt);
  bullets = bullets.filter(b => b.y > -10);

  // 적 이동 및 공격
  const t = performance.now() / 1000;
  enemyTimer += dt;
  enemies.forEach((e, i) => {
    e.x = e.baseX + Math.sin(t * 1.2 + e.phase) * 18;
    e.y += (8 + level * 2) * dt;
    if (e.y > canvas.height - 75) {
      e.y = 40;
      e.baseX = 25 + Math.random() * 350;
    }
    if (enemyTimer > 0.65 && Math.random() < 0.055) {
      enemyBullets.push({x:e.x, y:e.y+12, speed:130+level*12});
    }
  });

  if (enemyTimer > 0.65) enemyTimer = 0;

  enemyBullets.forEach(b => b.y += b.speed * dt);
  enemyBullets = enemyBullets.filter(b => b.y < canvas.height + 10);

  // 플레이어 총알과 적 충돌
  bullets.forEach(b => {
    enemies.forEach(e => {
      if (!b.dead &&
          Math.abs(b.x - e.x) < 15 &&
          Math.abs(b.y - e.y) < 16) {
        b.dead = true;
        e.dead = true;
        score += 100;
        explode(e.x, e.y, "#ff426d");
      }
    });
  });
  bullets = bullets.filter(b => !b.dead);
  enemies = enemies.filter(e => !e.dead);

  // 적 총알과 플레이어 충돌
  enemyBullets.forEach(b => {
    if (!b.dead &&
        Math.abs(b.x - player.x) < 17 &&
        Math.abs(b.y - player.y) < 18) {
      b.dead = true;
      hitPlayer();
    }
  });
  enemyBullets = enemyBullets.filter(b => !b.dead);

  // 적과 플레이어 충돌
  enemies.forEach(e => {
    if (Math.abs(e.x-player.x)<24 && Math.abs(e.y-player.y)<25) {
      e.dead = true;
      hitPlayer();
    }
  });
  enemies = enemies.filter(e => !e.dead);

  particles.forEach(p => {
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.life -= dt;
  });
  particles = particles.filter(p => p.life > 0);

  if (enemies.length === 0) {
    level++;
    spawnEnemies();
    enemyBullets = [];
  }
  updateInfo();
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // 별 배경
  stars.forEach(s => {
    ctx.fillStyle = "#a5d7ff";
    ctx.globalAlpha = 0.4 + s.size / 4;
    ctx.fillRect(s.x, s.y, s.size, s.size);
  });
  ctx.globalAlpha = 1;

  enemies.forEach(drawEnemy);
  if (player && lives > 0) drawPlayer();

  ctx.shadowBlur = 10;
  ctx.shadowColor = "#42f5ff";
  ctx.fillStyle = "#42f5ff";
  bullets.forEach(b => ctx.fillRect(b.x-2, b.y-8, 4, 14));

  ctx.shadowColor = "#ff426d";
  ctx.fillStyle = "#ff426d";
  enemyBullets.forEach(b => {
    ctx.beginPath();
    ctx.arc(b.x, b.y, 4, 0, Math.PI*2);
    ctx.fill();
  });
  ctx.shadowBlur = 0;

  particles.forEach(p => {
    ctx.globalAlpha = Math.max(0, p.life);
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x, p.y, 4, 4);
  });
  ctx.globalAlpha = 1;
}

function loop(time) {
  if (!running) return;
  const dt = Math.min((time - (lastTime || time)) / 1000, 0.035);
  lastTime = time;
  update(dt);
  draw();
  if (running) animationId = requestAnimationFrame(loop);
}

function startGame() {
  reset();
}

document.addEventListener("keydown", e => {
  if (["ArrowLeft", "ArrowRight", " ", "ArrowUp", "ArrowDown"].includes(e.key)) {
    e.preventDefault();
  }
  keys[e.key] = true;
  if (e.key === "Enter" && !running) startGame();
});
document.addEventListener("keyup", e => keys[e.key] = false);

function bindHold(id, key) {
  const el = $(id);
  const down = e => {
    e.preventDefault();
    keys[key] = true;
    if (key === " ") shoot();
  };
  const up = e => {
    e.preventDefault();
    keys[key] = false;
  };
  el.addEventListener("pointerdown", down);
  el.addEventListener("pointerup", up);
  el.addEventListener("pointerleave", up);
  el.addEventListener("pointercancel", up);
}
bindHold("left", "ArrowLeft");
bindHold("right", "ArrowRight");
bindHold("fire", " ");

$("start").addEventListener("click", startGame);

// 캔버스를 터치하거나 드래그해서 우주선 이동
let dragging = false;
canvas.addEventListener("pointerdown", e => {
  dragging = true;
  movePlayer(e);
});
canvas.addEventListener("pointermove", e => {
  if (dragging) movePlayer(e);
});
canvas.addEventListener("pointerup", () => dragging = false);
canvas.addEventListener("pointercancel", () => dragging = false);
canvas.addEventListener("pointerleave", () => dragging = false);

function movePlayer(e) {
  if (!player) return;
  const rect = canvas.getBoundingClientRect();
  player.x = (e.clientX - rect.left) / rect.width * canvas.width;
  player.x = Math.max(18, Math.min(canvas.width-18, player.x));
}

function intro() {
  stars = Array.from({length:85}, () => ({
    x:Math.random()*canvas.width,
    y:Math.random()*canvas.height,
    speed:20+Math.random()*70,
    size:Math.random()*2+0.5
  }));
  player = {x:210,y:555,w:30,h:30,speed:270};
  bullets = [];
  enemies = [];
  enemyBullets = [];
  particles = [];
  draw();
  drawOverlay("GALAGA", "우주를 지켜라!");
}
intro();
</script>
</body>
</html>
